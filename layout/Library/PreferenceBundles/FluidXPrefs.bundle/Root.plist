			<key>PostNotification</key>
			<string>com.dolboebvaibcode.fluidx/ReloadPrefs</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Анимации</string>
			<key>footerText</key>
			<string>1.0 — как в системе. Меньше — быстрее, больше — медленнее. Ускоряет анимации интерфейса SpringBoard (открытие папок, свайпы, Пункт управления).</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
