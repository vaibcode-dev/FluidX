			<string>homeBarWidth</string>
			<key>default</key>
			<real>0</real>
			<key>minValue</key>
			<real>0</real>
			<key>maxValue</key>
			<real>220</real>
			<key>showValue</key>
			<true/>
			<key>PostNotification</key>
			<string>com.dolboebvaibcode.fluidx/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Прозрачность</string>
			<key>defaults</key>
			<string>com.dolboebvaibcode.fluidx</string>
