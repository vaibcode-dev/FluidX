<plist version="1.0">
<dict>
	<key>title</key>
	<string>FluidX</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Жесты iPhone X</string>
			<key>footerText</key>
			<string>Используется родной движок жестов SpringBoard, поэтому анимации плавные и не нагружают систему.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Включить жесты</string>
			<key>defaults</key>
			<string>com.dolboebvaibcode.fluidx</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.dolboebvaibcode.fluidx/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Показывать домашнюю полоску</string>
			<key>defaults</key>
			<string>com.dolboebvaibcode.fluidx</string>
			<key>key</key>
			<string>showHomeBar</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.dolboebvaibcode.fluidx/ReloadPrefs</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Домашняя полоска</string>
			<key>footerText</key>
			<string>0 — системный размер. Прозрачность 100% — как в системе. Цвет задаётся в HEX: например FF2D55 или 00A3FF. Пустое поле — системный цвет (сам становится светлым или тёмным).</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Высота</string>
			<key>defaults</key>
			<string>com.dolboebvaibcode.fluidx</string>
			<key>key</key>
			<string>homeBarHeight</string>
			<key>default</key>
			<real>0</real>
			<key>minValue</key>
			<real>0</real>
			<key>maxValue</key>
			<real>12</real>
			<key>showValue</key>
			<true/>
			<key>PostNotification</key>
			<string>com.dolboebvaibcode.fluidx/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
