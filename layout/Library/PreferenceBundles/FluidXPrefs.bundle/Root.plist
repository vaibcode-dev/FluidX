			<string>Telegram: @angel_gtag</string>
			<key>action</key>
			<string>openTelegram</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Последний лог сборки</string>
			<key>action</key>
			<string>openBuildLog</string>
