#!/bin/sh
# FluidX — postinst
#
# 1. Пишет диагностику в /var/mobile/FluidX-diag.txt, чтобы было видно,
#    установлен ли PreferenceLoader и на месте ли файлы настроек.
# 2. Перезапускает Настройки, чтобы новый раздел появился сразу.

LOG=/var/mobile/FluidX-diag.txt

{
	echo "FluidX postinst: $(date)"
	echo
	echo "=== PreferenceLoader: папка настроек ==="
	ls -l /var/jb/Library/PreferenceLoader/Preferences 2>&1 | head -n 30
	echo
	echo "=== PreferenceLoader: dylib в DynamicLibraries ==="
	ls -l /var/jb/Library/MobileSubstrate/DynamicLibraries 2>&1 | grep -iE 'prefer|libprefs|prefs' 
	echo "(если выше пусто — PreferenceLoader не установлен)"
	echo
	echo "=== Файлы FluidX ==="
	ls -l /var/jb/Library/MobileSubstrate/DynamicLibraries/FluidX.* 2>&1
	ls -l /var/jb/Library/PreferenceLoader/Preferences/FluidX.plist 2>&1
	ls -l /var/jb/Library/PreferenceBundles/FluidXPrefs.bundle 2>&1
	echo
	echo "=== Наш plist для PreferenceLoader ==="
	cat /var/jb/Library/PreferenceLoader/Preferences/FluidX.plist 2>&1
	echo
	echo "=== Установленная версия пакета ==="
	grep -A2 '^Package: com.dolboebvaibcode.fluidx$' /var/jb/Library/dpkg/status 2>/dev/null | head -n 5
} > "$LOG" 2>&1

chmod 644 "$LOG" 2>/dev/null

# Перезапускаем Настройки: только после этого они перечитывают список разделов.
for KILLALL in /var/jb/usr/bin/killall /usr/bin/killall killall; do
	if [ -x "$KILLALL" ] || command -v "$KILLALL" >/dev/null 2>&1; then
		"$KILLALL" -9 Preferences >/dev/null 2>&1
		break
	fi
done

exit 0
